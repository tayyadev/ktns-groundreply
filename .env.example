# Copy to .env and replace this secret with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Local Compose has a dev-only DB password fallback; set this for real deployments.
POSTGRES_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
# Optional Stripe billing (all four required to offer checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
